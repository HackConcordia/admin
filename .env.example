# See DEPLOY.md before deploying this version — it has a required migration step.

# MongoDB connection string INCLUDING the database name in the path.
# ConUHacks XI: use the XI cluster and the XI database (the same one the registration app uses).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# HS256 secret for the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every admin out.
JWT_SECRET=

# Legacy fallback, only read when JWT_SECRET is empty.
NEXTAUTH_SECRET=

# Absolute URL of this deployment; server components call their own API with it.
NEXT_PUBLIC_API_URL=http://localhost:3000

# SendGrid (admission / waitlist / refusal / Discord emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CONTACT_EMAIL=team.hackconcordia@ecaconcordia.ca

# ObjectId stored on QrCodeMapping documents at check-in (the ConUHacks XI event document)
EVENT_ID=<event-object-id>
