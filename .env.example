# See DEPLOY.md before deploying this version — it has a required migration step.

# MongoDB connection string INCLUDING the database name in the path.
# ConUHacks XI: use the XI cluster and the XI database (the same one the registration app uses).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# HS256 secret for the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every admin out.
JWT_SECRET=

# Legacy fallback, only read when JWT_SECRET is empty.
NEXTAUTH_SECRET=

# Absolute URL of this deployment; server components call their own API with it.
NEXT_PUBLIC_API_URL=http://localhost:3000

# SendGrid (admission / waitlist / refusal / Discord emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CONTACT_EMAIL=team.hackconcordia@ecaconcordia.ca

# Event settings (src/config/event.ts). EVENT_ID and EVENT_MEALS MUST equal the ConUHacks XI
# event-checkin Vercel project's values (roadmap contract C5). Generate EVENT_ID once per event:
#   node -e "console.log(new (require('mongoose').Types.ObjectId)().toHexString())"
# Admit/waitlist/refuse need only the email settings; organizer check-in also needs EVENT_ID and EVENT_MEALS (both required).
EVENT_ID=<event-object-id>
EVENT_NAME=ConUHacks XI
EVENT_DATES_LABEL=Saturday, February 6 and Sunday, February 7, 2027
EVENT_DATES_LABEL_FR=samedi 6 et dimanche 7 février 2027
# Include the article: the emails say "... takes place on <date> at <EVENT_VENUE>." / "... à <EVENT_VENUE_FR>."
EVENT_VENUE=Concordia University's John Molson Building, 1600 De Maisonneuve Blvd. West, Montreal
EVENT_VENUE_FR=l'édifice John-Molson de l'Université Concordia, 1600, boulevard De Maisonneuve Ouest, Montréal
# https only (http only for localhost). Same for the three optional URLs below.
REGISTRATION_URL=https://register.conuhacks.io/dashboard
EVENT_MEALS=[{"date":"2027-02-06","type":"breakfast"},{"date":"2027-02-06","type":"lunch"},{"date":"2027-02-06","type":"snacks"},{"date":"2027-02-06","type":"dinner"},{"date":"2027-02-07","type":"breakfast"},{"date":"2027-02-07","type":"lunch"}]
# Optional. The invite in the "Confirmed" email (same value as the registration app's DISCORD_INVITE_URL).
# Empty = that Discord email is skipped.
DISCORD_INVITE_URL=
# Optional overrides. When unset, the admission email links last year's ECA documents
# (drive.google.com, ConUHacks X). An invalid value makes the event settings fail loudly.
TRAVEL_GUIDELINES_URL=
TRAVEL_GUIDELINES_URL_FR=
